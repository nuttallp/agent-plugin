{
  "name": "clypmint",
  "version": "1.6.0",
  "description": "Edit footage, clip podcasts and create videos from scripts with playable previews and focused revisions.",
  "author": { "name": "Clypmint", "email": "parker@clypmint.com", "url": "https://clypmint.com" },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "homepage": "https://clypmint.com/chatgpt",
  "keywords": [
    "video editing",
    "AI video editor",
    "captions",
    "subtitles",
    "podcast clips",
    "shorts",
    "reels",
    "tiktok",
    "youtube",
    "talking head",
    "montage",
    "gaming highlights",
    "faceless video",
    "editing styles",
    "MCP"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Clypmint",
        "shortDescription": "Edit videos with your AI",
        "longDescription": "Turn your footage or approved script into a video. Review playable results, fix captions, revise a selected clip and continue the same project in Clypmint Studio. Existing account rights and usage limits apply.",
        "developerName": "Clypmint",
        "category": "Creativity",
        "websiteURL": "https://clypmint.com",
        "supportURL": "https://clypmint.com/chatgpt",
        "privacyPolicyURL": "https://clypmint.com/legal/privacy",
        "termsOfServiceURL": "https://clypmint.com/legal/terms",
        "brandColor": "#111111",
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/composer-icon.png",
        "brandColorDark": "#FFFFFF",
        "defaultPrompt": [
          "Edit my video, then help me revise it.",
          "Make a video from my approved script.",
          "Clip the 3 best moments about a topic from my podcast."
        ],
        "capabilities": [
          "Edit footage and captions",
          "Create videos from scripts",
          "Clip podcasts into Shorts",
          "Review and revise outputs",
          "Browse and reuse editing styles"
        ]
      },
      "onboardingSkill": "./skills/edit-video/SKILL.md"
    }
  }
}
